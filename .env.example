# =====================================================================
#  BDA Assignment 2 - Team 16 - cluster configuration
#  This is the ONLY file you need to edit to move from one laptop
#  (Mode A) to three real machines (Mode B).
# =====================================================================
COMPOSE_PROJECT_NAME=bda16

# ---- Node names ------------------------------------------------------
MASTER_HOST=master
WORKER_HOSTS=worker1,worker2

# ---- Mode B only: LAN IPs of the three machines ---------------------
MASTER_IP=192.168.1.10
WORKER1_IP=192.168.1.11
WORKER2_IP=192.168.1.12

# ---- HDFS -------------------------------------------------------------
HDFS_REPLICATION=2
# 32 MB blocks so that even a few GB of data is split across both workers
HDFS_BLOCK_SIZE=33554432

# ---- YARN / MapReduce memory (tuned for Docker Desktop with 8 GB) ----
YARN_NM_MEMORY_MB=1536
YARN_NM_VCORES=3
YARN_MIN_ALLOC_MB=256
YARN_MAX_ALLOC_MB=1536
MAP_MEMORY_MB=512
MAP_JAVA_OPTS=-Xmx400m
REDUCE_MEMORY_MB=512
REDUCE_JAVA_OPTS=-Xmx400m
AM_MEMORY_MB=512
AM_JAVA_OPTS=-Xmx400m
# Heap for each Hadoop daemon (NameNode, DataNode, RM, NM, ...)
HADOOP_DAEMON_HEAP_MB=384

# ---- Hive metastore database (PostgreSQL) ----------------------------
METASTORE_DB_HOST=metastore-db
METASTORE_DB_NAME=metastore
METASTORE_DB_USER=hive
METASTORE_DB_PASSWORD=changeme

# ---- MongoDB ------------------------------------------------------------
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_CACHE_GB=0.5

# ---- Dataset ------------------------------------------------------------
GHCN_START_YEAR=2023
GHCN_END_YEAR=2025
# Year(s) loaded into MongoDB (comma separated)
MONGO_YEARS=2023,2024,2025
# Station-id prefixes NOT loaded into MongoDB (comma separated). US1 = CoCoRaHS volunteer
# rain gauges: ~46% of all station-days but precipitation only. Empty = load everything.
MONGO_EXCLUDE_PREFIX=US1
