# Force LF line endings for everything that runs inside Linux containers.
# CRLF endings break bash ("\r: command not found"), XML parsers and Pig/Hive scripts.
* text=auto
*.sh   text eol=lf
*.xml  text eol=lf
*.pig  text eol=lf
*.hql  text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.java text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
workers text eol=lf
.env   text eol=lf
*.ps1  text eol=crlf
*.png  binary
*.gz   binary
*.jar  binary
