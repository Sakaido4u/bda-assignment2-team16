================================================================
## 7. Copy a file from HDFS back to the local filesystem
================================================================
$ rm -f /tmp/stations_copy.tsv && hdfs dfs -get /ghcn/stations/stations.tsv /tmp/stations_copy.tsv
$ ls -lh /tmp/stations_copy.tsv && wc -l /tmp/stations_copy.tsv
-rw-r--r-- 1 root root 8.8M Oct 27 05:02 /tmp/stations_copy.tsv
133039 /tmp/stations_copy.tsv

================================================================
## 8. Create and remove a temporary directory
================================================================
$ hdfs dfs -mkdir -p /ghcn/tmp_demo && hdfs dfs -cp /ghcn/countries/countries.tsv /ghcn/tmp_demo/
$ hdfs dfs -ls /ghcn/tmp_demo
Found 1 items
-rw-r--r--   2 root supergroup       3488 2026-10-27 05:02 /ghcn/tmp_demo/countries.tsv
$ hdfs dfs -rm -r -skipTrash /ghcn/tmp_demo
Deleted /ghcn/tmp_demo

================================================================
## 9. Replication factor and block size of a raw file
================================================================
$ hdfs dfs -stat 'name=%n replication=%r blocksize=%o size=%b' /ghcn/raw/2025.csv
name=2025.csv replication=2 blocksize=33554432 size=1310928099

